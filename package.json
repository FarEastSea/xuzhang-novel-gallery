{
  "name": "xuzhang-novel-gallery",
  "private": true,
  "version": "0.8.11",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:release": "node scripts/check-release.mjs",
    "dev:server": "node --watch --env-file-if-exists=.env server.mjs",
    "version:set": "node scripts/version.mjs set",
    "version:next": "node scripts/version.mjs next",
    "version:check": "node scripts/version.mjs check"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "playwright-core": "^1.65.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "license": "UNLICENSED"
}
